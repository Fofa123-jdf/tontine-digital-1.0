<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tontine Digital 1.0 — Membre</title><style>body{font-family:Arial;margin:0;background:#eef7f3;color:#163c31}.wrap{max-width:520px;margin:auto;padding:18px}.card{background:white;border-radius:18px;padding:18px;margin:12px 0;box-shadow:0 5px 18px #0001}button,input,select,textarea{width:100%;padding:11px;margin:5px 0;border-radius:10px;border:1px solid #cbded7;box-sizing:border-box}button{background:#006b4f;color:#fff;border:0;font-weight:bold}.mut{color:#6b7d76;font-size:13px}.row{padding:10px 0;border-bottom:1px solid #eee}.danger{background:#9b2c2c}</style><div class="wrap"><h1>🌿 Tontine Digital 1.0</h1><div id="app"></div></div><script>const API=localStorage.TD_API||'http://localhost:3000/api',app=document.getElementById('app');let token=localStorage.TD_TOKEN;const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));async function api(path,opt={}){opt.headers={...(opt.headers||{}),'Content-Type':'application/json',...(token?{Authorization:'Bearer '+token}:{})};let r=await fetch(API+path,opt),d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||'Erreur');return d}function loginView(){app.innerHTML='<div class="card"><h2>Connexion</h2><input id=i placeholder="Téléphone ou email"><input id=p type=password placeholder="Mot de passe"><button onclick="login()">Se connecter</button><button onclick="registerView()">Créer un compte</button></div>'}function registerView(){app.innerHTML='<div class="card"><h2>Créer un compte</h2><input id=n placeholder="Nom complet"><input id=d type=date><input id=t placeholder="Téléphone"><input id=e placeholder="Email"><input id=p type=password placeholder="Mot de passe (8 caractères min.)"><input id=r placeholder="Code parrain (facultatif)"><button onclick="register()">Créer mon compte</button><button onclick="loginView()">Retour</button></div>'}async function register(){try{let d=await api('/auth/register',{method:'POST',body:JSON.stringify({name:n.value,dob:d.value,phone:t.value,email:e.value,password:p.value,referralCode:r.value||null})});token=d.token;localStorage.TD_TOKEN=token;home()}catch(e){alert(e.message)}}async function login(){try{let d=await api('/auth/login',{method:'POST',body:JSON.stringify({identifier:i.value,password:p.value})});token=d.token;localStorage.TD_TOKEN=token;home()}catch(e){alert(e.message)}}async function home(){try{let u=await api('/me'),ts=await api('/tontines'),ps=await api('/payments');app.innerHTML='<div class="card"><h2>Bienvenue, '+esc(u.full_name)+'</h2><p>Code parrain : <b>'+esc(u.referral_code)+'</b></p><button class="danger" onclick="logout()">Déconnexion</button></div><div class="card"><h2>Tontines</h2><div id=t>'+ts.map(x=>'<div class="row"><b>'+esc(x.name)+'</b><br>'+x.contribution_amount+' FCFA · '+x.member_count+' membre(s)<br><button onclick="join(\''+x.id+'\')">Adhérer</button><button onclick="pay(\''+x.id+'\')">Préparer une cotisation</button></div>').join('')+'</div></div><div class="card"><h2>Mes cotisations</h2>'+ps.map(x=>'<div class="row">'+esc(x.tontine_name)+' — '+x.total_amount+' FCFA — <b>'+x.status+'</b></div>').join('')+'</div>'}catch(e){localStorage.removeItem('TD_TOKEN');token=null;loginView()}}async function join(id){try{let x=await api('/tontines/'+id+'/join',{method:'POST'});alert('Adhésion confirmée. Position : '+x.position)}catch(e){alert(e.message)}}async function pay(id){try{let x=await api('/payments/preview',{method:'POST',body:JSON.stringify({tontineId:id})});if(!confirm('Base '+x.baseAmount+' + admin '+x.adminCommission+' + parrain '+x.sponsorCommission+' = '+x.totalAmount+' FCFA. Créer le paiement ?'))return;let p=await api('/payments',{method:'POST',body:JSON.stringify({tontineId:id,idempotencyKey:crypto.randomUUID(),provider:'MANUAL'})});alert('Paiement créé: '+p.id+' / statut '+p.status);home()}catch(e){alert(e.message)}}function logout(){localStorage.removeItem('TD_TOKEN');token=null;loginView()}token?home():loginView()</script></html>
