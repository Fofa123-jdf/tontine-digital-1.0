<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tontine Digital 1.0 — Administration</title><style>body{font-family:Arial;margin:0;background:#f4f7f5;color:#17231d}.wrap{max-width:1100px;margin:auto;padding:18px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card{background:#fff;border-radius:16px;padding:16px;margin:12px 0;box-shadow:0 4px 16px #0001}button,input,select{padding:10px;border-radius:9px;border:1px solid #ccd9d3;margin:4px;box-sizing:border-box}button{background:#16803c;color:#fff;border:0;font-weight:bold}.row{padding:9px;border-bottom:1px solid #eee}.mut{color:#68756f}@media(max-width:700px){.grid{grid-template-columns:1fr 1fr}}</style><div class="wrap"><h1>🏦 Tontine Digital 1.0</h1><div id=a></div></div><script>const API=localStorage.TD_API||'http://localhost:3000/api',a=document.getElementById('a');let token=localStorage.TD_ADMIN_TOKEN;async function api(p,o={}){o.headers={...(o.headers||{}),'Content-Type':'application/json',Authorization:'Bearer '+token};let r=await fetch(API+p,o),d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||'Erreur');return d}function login(){a.innerHTML='<div class="card"><h2>Connexion administrateur</h2><input id=i placeholder="Email"><input id=p type=password placeholder="Mot de passe"><button onclick="go()">Entrer</button></div>'}async function go(){try{let r=await fetch(API+'/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({identifier:i.value,password:p.value})});let d=await r.json();if(!r.ok)throw Error(d.error);token=d.token;localStorage.TD_ADMIN_TOKEN=token;dash()}catch(e){alert(e.message)}}async function dash(){try{let [o,u,t,p,l]=await Promise.all([api('/admin/overview'),api('/admin/users'),api('/admin/tontines'),api('/admin/payments'),api('/admin/ledger')]);a.innerHTML='<div class="grid"><div class="card"><b>Membres</b><h2>'+o.members+'</h2></div><div class="card"><b>Tontines</b><h2>'+o.tontines+'</h2></div><div class="card"><b>Cotisations</b><h2>'+o.contributions+' FCFA</h2></div><div class="card"><b>Commissions</b><h2>'+o.commissions+' FCFA</h2></div></div><div class="card"><h2>Créer une tontine</h2><input id=tn placeholder="Nom"><input id=ta type=number placeholder="Cotisation FCFA"><select id=tf><option>WEEKLY</option><option>BIWEEKLY</option><option>MONTHLY</option></select><input id=td type=date><button onclick="createT()">Créer</button></div><div class="card"><h2>Membres</h2>'+u.map(x=>'<div class=row>'+x.full_name+' · '+x.phone+' · '+x.role+'</div>').join('')+'</div><div class="card"><h2>Tontines</h2>'+t.map(x=>'<div class=row>'+x.name+' · '+x.contribution_amount+' FCFA · '+x.member_count+' membre(s)</div>').join('')+'</div><div class="card"><h2>Paiements</h2>'+p.map(x=>'<div class=row>'+x.full_name+' · '+x.tontine_name+' · '+x.total_amount+' FCFA · <b>'+x.status+'</b></div>').join('')+'</div><div class="card"><h2>Grand livre</h2>'+l.map(x=>'<div class=row>'+x.fund_type+' · '+x.amount+' FCFA · '+x.tontine_name+'</div>').join('')+'</div><button onclick="localStorage.removeItem(\'TD_ADMIN_TOKEN\');location.reload()">Déconnexion</button>'}catch(e){localStorage.removeItem('TD_ADMIN_TOKEN');token=null;login()}}async function createT(){try{await api('/admin/tontines',{method:'POST',body:JSON.stringify({name:tn.value,contributionAmount:Number(ta.value),frequency:tf.value,startDate:td.value})});dash()}catch(e){alert(e.message)}}token?dash():login()</script></html>
